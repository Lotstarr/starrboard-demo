{
  "name": "Starrboard",
  "version": "1.0-midnight-pastel",
  "status": "approved-initial-baseline",
  "theme": "dark",
  "colors": {
    "background": "#040B1B",
    "navigation": "#071126",
    "surface": "#122747",
    "raised": "#26476F",
    "selected": "#1D3B65",
    "recommendation": "#132543",
    "text": "#F7FAFF",
    "secondaryText": "#CAD8EF",
    "accent": "#9AC9FF",
    "violet": "#DDC4FF",
    "teal": "#9DEBE1",
    "blueHeader": "#BAD8FF",
    "violetHeader": "#DCC8FF",
    "tealHeader": "#A5EBE4",
    "featureInk": "#0A1834",
    "primaryAction": "#9BC7FF",
    "primaryActionText": "#0A1834",
    "warning": "#F8D88E",
    "urgent": "#FFB2BB",
    "success": "#9AE6C0",
    "divider": "#395D86",
    "inputBoundary": "#788DAD"
  },
  "type": {
    "fontFamily": "Segoe UI, system-ui, Arial, sans-serif",
    "bodyPx": 14,
    "metadataPx": 12,
    "auxiliaryMinimumPx": 11,
    "panelHeadingPx": 16,
    "pageHeadingPx": 30,
    "mobileHeadingPx": 26,
    "weights": [400, 500],
    "lineHeight": 1.5,
    "headingLineHeight": 1.2
  },
  "spacingPx": [4, 8, 12, 16, 24, 32],
  "radiusPx": { "badge": 4, "control": 6, "widget": 9 },
  "layout": {
    "defaultDestination": "home",
    "homeCardColumns": 4,
    "homeTabletCardColumns": 6,
    "homeMobileCardColumns": 12,
    "columns": 12,
    "gapPx": 16,
    "compactGapPx": 10,
    "desktopSidebarPx": 200,
    "desktopPaddingPx": 32,
    "drawerPx": 340,
    "schoolColumns": 8,
    "expandedSchoolColumns": 12,
    "scheduleColumns": 4,
    "breakpointsPx": [600, 850, 1200]
  },
  "icons": { "family": "Lucide", "sizePx": 16 },
  "interaction": {
    "coarsePointerMinimumTargetPx": 44,
    "focusRingPx": 2,
    "transitionMs": [120, 160],
    "honorReducedMotion": true,
    "movementRequiresEditMode": true
  }
